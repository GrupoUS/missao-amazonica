---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Icon from '@/components/ui/Icon.astro';
import Input from '@/components/ui/Input.astro';
import Select from '@/components/ui/Select.astro';
import Textarea from '@/components/ui/Textarea.astro';
import { getSupabaseAdmin } from '@/lib/supabase/admin';
import { logAudit } from '@/lib/audit/log';
import { parseBRLToCents, formatBRL } from '@/lib/format/currency';

export const prerender = false;

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/accountability', 302);

const admin = getSupabaseAdmin();
const user = Astro.locals.user;

const { data: entry } = await admin
  .from('accountability_entries')
  .select('*')
  .eq('id', id)
  .maybeSingle();

if (!entry) return Astro.redirect('/admin/accountability', 302);

const { data: items } = await admin
  .from('donation_items')
  .select('id, title')
  .order('title');

let formError: string | null = null;
let formOk: string | null = null;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const title = String(fd.get('title') ?? '').trim();
  const description = String(fd.get('description') ?? '').trim();
  const itemId = String(fd.get('item_id') ?? '') || null;
  const amount = String(fd.get('amount') ?? '');
  const proofUrl = String(fd.get('proof_url') ?? '').trim() || null;
  const mediaUrl = String(fd.get('media_url') ?? '').trim() || null;
  const status = String(fd.get('status') ?? 'planned');
  const isPublic = fd.get('is_public') === 'on';

  if (!title) {
    formError = 'Título é obrigatório.';
  } else {
    const before = { ...entry };
    const amountCents = amount ? parseBRLToCents(amount) : null;
    const { error } = await admin
      .from('accountability_entries')
      .update({
        title,
        description: description || null,
        item_id: itemId,
        amount_cents: amountCents,
        proof_url: proofUrl,
        media_url: mediaUrl,
        status: status as 'planned' | 'purchased' | 'delivered' | 'completed',
        is_public: isPublic,
      })
      .eq('id', id);
    if (error) {
      formError = error.message;
    } else {
      formOk = 'Atualizado com sucesso.';
      await logAudit({
        actorId: user?.id ?? null,
        action: 'accountability_entry.updated',
        entityType: 'accountability_entry',
        entityId: id,
        before: before as never,
        after: { title, status, amount_cents: amountCents, item_id: itemId } as never,
      });
      Object.assign(entry, { title, description, item_id: itemId, amount_cents: amountCents, proof_url: proofUrl, media_url: mediaUrl, status, is_public: isPublic });
    }
  }
}

const amountDisplay = entry.amount_cents != null ? formatBRL(entry.amount_cents).replace('R$', '').trim() : '';
---

<AdminLayout title={`Editar · ${entry.title}`} activeNav="transparencia">
  <nav class="type-caption text-on-surface-variant mb-md flex items-center gap-2">
    <a href="/admin/accountability" class="hover:text-primary-container">Transparência</a>
    <Icon name="chevron_right" size={12} />
    <span class="text-on-surface">{entry.title}</span>
  </nav>

  <header class="mb-xl">
    <p class="type-label text-on-surface-variant mb-xs">Editar prestação</p>
    <h2 class="font-display type-h2 text-on-surface">{entry.title}</h2>
  </header>

  <Card class="p-xl">
    <form method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-md">
      {formError && (
        <div role="alert" class="md:col-span-2 bg-error-container text-on-error-container px-md py-sm rounded-lg type-label">
          {formError}
        </div>
      )}
      {formOk && (
        <div role="status" class="md:col-span-2 bg-secondary-container text-on-secondary-container px-md py-sm rounded-lg type-label">
          {formOk}
        </div>
      )}

      <Input label="Título" name="title" required value={entry.title} maxlength={200} />
      <Select label="Projeto vinculado" name="item_id">
        <option value="">— Reserva global —</option>
        {items?.map((i) => (
          <option value={i.id} selected={i.id === entry.item_id}>{i.title}</option>
        ))}
      </Select>

      <Input label="Valor (R$)" name="amount" value={amountDisplay} inputmode="decimal" />
      <Select label="Status" name="status">
        <option value="planned" selected={entry.status === 'planned'}>Planejado</option>
        <option value="purchased" selected={entry.status === 'purchased'}>Comprado</option>
        <option value="delivered" selected={entry.status === 'delivered'}>Entregue</option>
        <option value="completed" selected={entry.status === 'completed'}>Concluído</option>
      </Select>

      <Input label="URL do comprovante" name="proof_url" value={entry.proof_url ?? ''} type="url" />
      <Input label="URL de mídia" name="media_url" value={entry.media_url ?? ''} type="url" />

      <div class="md:col-span-2">
        <Textarea label="Descrição" name="description" rows={5}>
          {entry.description ?? ''}
        </Textarea>
      </div>

      <label class="md:col-span-2 inline-flex items-center gap-sm type-label text-on-surface-variant cursor-pointer">
        <input
          type="checkbox"
          name="is_public"
          checked={entry.is_public}
          class="size-4 rounded border-outline-variant text-secondary focus:ring-secondary"
        />
        Tornar público
      </label>

      <div class="md:col-span-2 flex justify-end gap-md mt-md">
        <a href="/admin/accountability" class="border border-outline-variant text-on-surface-variant px-md py-sm rounded-lg type-label hover:bg-surface-container-low">
          Voltar
        </a>
        <button type="submit" class="bg-primary-container text-on-primary px-md py-sm rounded-lg type-label font-semibold shadow-cta hover:opacity-90">
          Salvar alterações
        </button>
      </div>
    </form>
  </Card>
</AdminLayout>
