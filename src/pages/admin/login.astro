---
import '@/styles/global.css';
import Icon from '@/components/ui/Icon.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');

let formError: string | null = null;
let formEmail = '';

const url = new URL(Astro.request.url);
if (url.searchParams.get('error') === 'not_admin') {
  formError = 'Esta conta não tem permissão de administrador.';
}
if (url.searchParams.get('reset') === 'sent') {
  formError = null;
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  formEmail = String(formData.get('email') ?? '').trim();
  const password = String(formData.get('password') ?? '');

  if (!formEmail || !password) {
    formError = 'Informe e-mail e senha.';
  } else {
    const { data, error } = await Astro.locals.supabase.auth.signInWithPassword({
      email: formEmail,
      password,
    });
    if (error || !data?.user) {
      formError = 'Credenciais inválidas.';
    } else {
      // @ts-expect-error — rpc generics
      const { data: isAdmin } = await Astro.locals.supabase.rpc('is_admin', {
        uid: data.user.id,
      });
      if (!isAdmin) {
        await Astro.locals.supabase.auth.signOut();
        formError = 'Esta conta não tem permissão de administrador.';
      } else {
        return Astro.redirect('/admin', 302);
      }
    }
  }
}

const resetSent = url.searchParams.get('reset') === 'sent';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar · Missão Amazônica</title>
    <meta name="robots" content="noindex,nofollow" />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('salda-theme') || 'system';
          var resolved = stored === 'system'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : stored;
          if (resolved === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Literata:wght@600;700&display=swap"
    />
  </head>
  <body class="bg-background text-on-background antialiased min-h-screen">
    <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_1fr] min-h-screen">
      <!-- Brand panel (foto + overlay) -->
      <aside class="relative overflow-hidden h-48 lg:h-auto order-1">
        <img
          src="/images/mission/login-bencao.jpg"
          alt="Pastor abençoando idosa ribeirinha durante visita da Missão Amazônica"
          width={1200}
          height={900}
          loading="eager"
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-primary/85 via-primary/70 to-primary-container/55"></div>
        <div class="absolute inset-0 flex items-end lg:items-center p-md lg:p-xxl">
          <div class="max-w-md text-on-primary">
            <div class="hidden lg:flex items-center gap-2 mb-lg">
              <img
                src="/images/brand/logo.jpg"
                alt=""
                aria-hidden="true"
                width={40}
                height={40}
                class="size-10 rounded-full bg-surface-container-lowest object-cover border border-on-primary/20"
              />
              <span class="font-display text-lg font-semibold">Missão Amazônica</span>
            </div>
            <h2 class="font-display text-2xl lg:text-4xl leading-tight mb-sm hidden lg:block">
              Acesso restrito da operação.
            </h2>
            <p class="type-body opacity-90 hidden lg:block max-w-sm">
              Esta área é exclusiva para membros administradores. Cada ação fica
              registrada em log auditável.
            </p>
            <p class="font-display text-lg lg:hidden">Acesso restrito</p>
          </div>
        </div>
      </aside>

      <!-- Form panel -->
      <main class="flex items-center justify-center p-md lg:p-xxl order-2">
        <div class="w-full max-w-md flex flex-col gap-lg" style="width: 100%; max-width: 28rem;">
          <a
            href="/"
            class="self-start type-caption text-on-surface-variant hover:text-primary-container transition-colors inline-flex items-center gap-1"
          >
            <Icon name="chevron_left" size={14} /> Voltar ao site público
          </a>

          <div class="bg-surface-container-lowest rounded-3xl p-xl shadow-modal border border-outline-variant/30">
            <h1 class="font-display type-h2 text-on-surface mb-sm">Acesso administrativo</h1>
            <p class="type-body text-on-surface-variant mb-lg">
              Entre com suas credenciais de administrador da missão.
            </p>

            {resetSent && (
              <div role="status" aria-live="polite" class="bg-secondary-container/40 text-on-secondary-container px-md py-sm rounded-lg type-label mb-md flex items-start gap-2">
                <Icon name="check_circle" size={16} class="mt-0.5 shrink-0" />
                <span>Se a conta existir, enviamos um link de recuperação. Confira sua caixa de entrada.</span>
              </div>
            )}

            <form method="POST" class="flex flex-col gap-md">
              <div class="flex flex-col gap-1">
                <label for="email" class="type-label text-on-surface-variant">E-mail</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  value={formEmail}
                  class="w-full bg-surface-container-low border border-transparent focus:border-secondary focus:ring-1 focus:ring-secondary rounded-lg py-3 px-4 type-body text-on-surface outline-none transition-colors"
                  style="width: 100%;"
                />
              </div>
              <div class="flex flex-col gap-1">
                <div class="flex items-center justify-between">
                  <label for="password" class="type-label text-on-surface-variant">Senha</label>
                  <button
                    type="button"
                    data-forgot-trigger
                    class="type-caption text-secondary hover:text-primary-container transition-colors"
                  >
                    Esqueci minha senha
                  </button>
                </div>
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  autocomplete="current-password"
                  class="w-full bg-surface-container-low border border-transparent focus:border-secondary focus:ring-1 focus:ring-secondary rounded-lg py-3 px-4 type-body text-on-surface outline-none transition-colors"
                  style="width: 100%;"
                />
              </div>
              {formError && (
                <div role="alert" class="bg-error-container text-on-error-container px-md py-sm rounded-lg type-label flex items-start gap-2">
                  <Icon name="priority_high" size={16} class="mt-0.5 shrink-0" />
                  <span>{formError}</span>
                </div>
              )}
              <button
                type="submit"
                class="w-full bg-primary-container text-on-primary py-3 rounded-lg type-label font-semibold shadow-cta hover:opacity-90 transition-opacity"
              >
                Entrar
              </button>
            </form>
          </div>
        </div>
      </main>
    </div>

    <!-- Forgot password dialog -->
    <dialog
      id="forgot-dialog"
      class="bg-surface-container-lowest rounded-2xl p-xl shadow-modal border border-outline-variant/30 max-w-md w-[calc(100%-2rem)] backdrop:bg-on-surface/30"
    >
      <form method="dialog" class="flex flex-col gap-md" id="forgot-form">
        <div class="flex items-start justify-between gap-md">
          <h2 class="font-display type-h3 text-on-surface">Recuperar senha</h2>
          <button
            type="button"
            value="cancel"
            data-forgot-close
            class="text-on-surface-variant hover:text-on-surface p-1 -m-1 rounded-md"
            aria-label="Fechar"
          >
            <Icon name="delete" size={18} />
          </button>
        </div>
        <p class="type-body text-on-surface-variant">
          Informe seu e-mail. Se a conta existir, enviaremos um link para redefinir.
        </p>
        <label for="forgot-email" class="type-label text-on-surface-variant">E-mail</label>
        <input
          id="forgot-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="w-full bg-surface-container-low border border-transparent focus:border-secondary focus:ring-1 focus:ring-secondary rounded-lg py-3 px-4 type-body text-on-surface outline-none transition-colors"
          style="width: 100%;"
        />
        <div class="flex flex-col gap-sm" id="forgot-status" aria-live="polite"></div>
        <div class="flex gap-md justify-end">
          <button
            type="button"
            data-forgot-close
            class="px-md py-2 type-label text-on-surface-variant hover:text-on-surface rounded-lg"
          >
            Cancelar
          </button>
          <button
            type="submit"
            class="bg-primary-container text-on-primary px-md py-2 rounded-lg type-label font-semibold shadow-cta hover:opacity-90 transition-opacity"
          >
            Enviar link
          </button>
        </div>
      </form>
    </dialog>

    <script is:inline>
      (function () {
        var dialog = document.getElementById('forgot-dialog');
        var form = document.getElementById('forgot-form');
        var status = document.getElementById('forgot-status');
        if (!dialog || !form || !status) return;

        document.querySelectorAll('[data-forgot-trigger]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            status.innerHTML = '';
            if (typeof dialog.showModal === 'function') dialog.showModal();
            else dialog.setAttribute('open', 'true');
            var firstInput = document.getElementById('forgot-email');
            if (firstInput) setTimeout(function () { firstInput.focus(); }, 0);
          });
        });

        // Backdrop click closes dialog
        dialog.addEventListener('click', function (ev) {
          if (ev.target === dialog) {
            if (typeof dialog.close === 'function') dialog.close();
            else dialog.removeAttribute('open');
          }
        });

        document.querySelectorAll('[data-forgot-close]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            if (typeof dialog.close === 'function') dialog.close();
            else dialog.removeAttribute('open');
          });
        });

        form.addEventListener('submit', function (ev) {
          ev.preventDefault();
          var email = (document.getElementById('forgot-email') || {}).value || '';
          status.innerHTML = '<span class="type-caption text-on-surface-variant">Enviando…</span>';
          fetch('/api/auth/forgot', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email })
          })
            .then(function () {
              status.innerHTML = '<span class="type-caption text-secondary">Se a conta existir, enviaremos o link em instantes.</span>';
              setTimeout(function () {
                if (typeof dialog.close === 'function') dialog.close();
                else dialog.removeAttribute('open');
                window.location.search = '?reset=sent';
              }, 1400);
            })
            .catch(function () {
              status.innerHTML = '<span class="type-caption text-error">Falha ao enviar. Tente novamente em instantes.</span>';
            });
        });
      })();
    </script>

    <SpeedInsights />
    <Analytics />
  </body>
</html>
