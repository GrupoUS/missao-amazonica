---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import { cn } from '@/lib/utils';

interface Props extends Omit<HTMLAttributes<'select'>, 'class'> {
  label?: string;
  hint?: string;
  error?: string;
  class?: string;
}

const { id, label, hint, error, required, class: className, ...rest } = Astro.props as Props;
const selectId = id ?? `field-${Math.random().toString(36).slice(2, 9)}`;
const selectClasses = cn(
  'appearance-none w-full bg-surface-container-low border border-transparent rounded-lg py-sm pl-md pr-xl type-body text-on-surface cursor-pointer outline-none transition-colors',
  'focus:border-secondary focus:ring-1 focus:ring-secondary',
  error && 'border-error focus:border-error focus:ring-error',
  className,
);
---

<div class="flex flex-col gap-1">
  {label && (
    <label for={selectId} class="type-label text-on-surface-variant">
      {label}
      {required && <span aria-hidden="true" class="text-error ml-1">*</span>}
    </label>
  )}
  <div class="relative">
    <select id={selectId} class={selectClasses} {...(rest as HTMLAttributes<'select'>)}>
      <slot />
    </select>
    <span class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-outline">
      <Icon name="expand_more" size={16} />
    </span>
  </div>
  {hint && !error && <p class="type-caption text-on-surface-variant">{hint}</p>}
  {error && <p class="type-caption text-error" role="alert">{error}</p>}
</div>
