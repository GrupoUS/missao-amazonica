---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '@/lib/utils';

interface Props extends Omit<HTMLAttributes<'input'>, 'class'> {
  label?: string;
  hint?: string;
  error?: string;
  class?: string;
}

const {
  id,
  label,
  hint,
  error,
  required,
  class: className,
  ...rest
} = Astro.props as Props;

const inputId = id ?? `field-${Math.random().toString(36).slice(2, 9)}`;

const inputClasses = cn(
  'w-full bg-surface-container-low border border-transparent rounded-lg py-sm px-md type-body text-on-surface placeholder:text-outline outline-none transition-colors',
  'focus:border-secondary focus:ring-1 focus:ring-secondary',
  error && 'border-error focus:border-error focus:ring-error',
  className,
);
---

<div class="flex flex-col gap-1">
  {label && (
    <label for={inputId} class="type-label text-on-surface-variant">
      {label}
      {required && <span aria-hidden="true" class="text-error ml-1">*</span>}
    </label>
  )}
  <input id={inputId} class={inputClasses} {...(rest as HTMLAttributes<'input'>)} />
  {hint && !error && <p class="type-caption text-on-surface-variant">{hint}</p>}
  {error && <p class="type-caption text-error" role="alert">{error}</p>}
</div>
