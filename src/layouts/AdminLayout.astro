---
import '@/styles/global.css';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  title?: string;
  activeNav?: 'painel' | 'doacoes' | 'projetos' | 'logs' | 'configuracoes' | 'transparencia';
}

const { title = 'Painel · Missão Amazônica', activeNav } = Astro.props;
const user = Astro.locals.user;
const userEmail = user?.email ?? '';
const userInitials = (userEmail.split('@')[0] ?? '?')
  .slice(0, 2)
  .toUpperCase();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Literata:wght@600;700&family=Nunito+Sans:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="bg-background text-on-surface antialiased flex min-h-screen">
    <a href="#admin-content" class="skip-link">Pular para o conteúdo</a>

    <aside class="bg-[#faf6f0] font-nav h-screen w-64 border-r border-outline-variant/30 fixed left-0 top-0 flex flex-col py-6 z-40">
      <div class="px-6 mb-8 flex items-center gap-3">
        <div class="size-10 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-semibold shrink-0">
          {userInitials}
        </div>
        <div class="min-w-0">
          <h1 class="font-display font-bold text-primary-container text-sm leading-tight truncate">Gestão Sal da Terra</h1>
          <p class="text-xs text-on-surface-variant mt-0.5 truncate">{userEmail || 'Administrador'}</p>
        </div>
      </div>

      <nav class="flex-1 flex flex-col gap-1 px-4 overflow-y-auto" aria-label="Navegação administrativa">
        <a
          href="/admin"
          class:list={[
            'px-4 py-3 flex items-center gap-3 rounded-xl transition-colors duration-200',
            activeNav === 'painel'
              ? 'bg-primary-container text-on-primary shadow-card'
              : 'text-on-surface-variant hover:bg-primary-container/10',
          ]}
        >
          <Icon name="dashboard" size={20} />
          <span class="font-medium text-sm">Painel</span>
        </a>
        <a
          href="/admin/donations"
          class:list={[
            'px-4 py-3 flex items-center gap-3 rounded-xl transition-colors duration-200',
            activeNav === 'doacoes'
              ? 'bg-primary-container text-on-primary shadow-card'
              : 'text-on-surface-variant hover:bg-primary-container/10',
          ]}
        >
          <Icon name="hand_heart" size={20} />
          <span class="font-medium text-sm">Doações</span>
        </a>
        <a
          href="/admin/items"
          class:list={[
            'px-4 py-3 flex items-center gap-3 rounded-xl transition-colors duration-200',
            activeNav === 'projetos'
              ? 'bg-primary-container text-on-primary shadow-card'
              : 'text-on-surface-variant hover:bg-primary-container/10',
          ]}
        >
          <Icon name="forest" size={20} />
          <span class="font-medium text-sm">Projetos</span>
        </a>
        <a
          href="/admin/accountability"
          class:list={[
            'px-4 py-3 flex items-center gap-3 rounded-xl transition-colors duration-200',
            activeNav === 'transparencia'
              ? 'bg-primary-container text-on-primary shadow-card'
              : 'text-on-surface-variant hover:bg-primary-container/10',
          ]}
        >
          <Icon name="receipt_long" size={20} />
          <span class="font-medium text-sm">Transparência</span>
        </a>
        <a
          href="/admin/settings"
          class:list={[
            'px-4 py-3 flex items-center gap-3 rounded-xl transition-colors duration-200',
            activeNav === 'configuracoes'
              ? 'bg-primary-container text-on-primary shadow-card'
              : 'text-on-surface-variant hover:bg-primary-container/10',
          ]}
        >
          <Icon name="settings" size={20} />
          <span class="font-medium text-sm">Configurações</span>
        </a>
      </nav>

      <div class="px-6 mt-auto pt-6 flex flex-col gap-2">
        <a
          href="/admin/items/new"
          class="w-full bg-primary-container text-on-primary hover:opacity-90 transition-opacity rounded-xl py-2.5 flex items-center justify-center gap-2 shadow-cta font-semibold text-sm"
        >
          <Icon name="add" size={16} />
          Novo Projeto
        </a>
        <form method="POST" action="/admin/logout">
          <button
            type="submit"
            class="w-full text-on-surface-variant hover:bg-error-container hover:text-on-error-container transition-colors rounded-xl py-2 flex items-center justify-center gap-2 text-xs"
          >
            Sair
          </button>
        </form>
      </div>
    </aside>

    <main id="admin-content" tabindex="-1" class="ml-64 flex-1 min-h-screen px-lg py-xl max-w-[1280px]">
      <slot />
    </main>
  </body>
</html>
