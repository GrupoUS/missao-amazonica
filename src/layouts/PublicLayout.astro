---
import '@/styles/global.css';
import Icon from '@/components/ui/Icon.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.tsx';
import { Toaster } from '@/components/ui/sonner.tsx';
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  activeNav?: 'missao' | 'projetos' | 'transparencia' | 'impacto';
  noindex?: boolean;
}

const SITE_NAME = import.meta.env.PUBLIC_SITE_NAME || 'Missão Amazônica – Sal da Terra';
const SITE_URL = import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321';

const {
  title = 'Missão Amazônica – Sal da Terra',
  description = 'Levando esperança, saúde e dignidade para comunidades ribeirinhas do Rio Negro através de ações concretas e transparentes.',
  ogImage,
  activeNav,
  noindex,
} = Astro.props;

const fullTitle = title === SITE_NAME ? title : `${title} · Missão Amazônica`;
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Apply theme class before first paint to prevent FOUC. Must run before stylesheet loads. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('salda-theme') || 'system';
          var resolved = stored === 'system'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : stored;
          if (resolved === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Literata:wght@600;700&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#012d1d" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1411" media="(prefers-color-scheme: dark)" />

    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {/* Organization JSON-LD for SEO + GEO citation readiness */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'NGO',
      name: SITE_NAME,
      url: SITE_URL,
      logo: `${SITE_URL}/images/brand/logo.jpg`,
      description: 'Plataforma de doações da Missão Amazônica – Sal da Terra. Atuamos nas comunidades ribeirinhas do Rio Negro com transparência total.',
      areaServed: {
        '@type': 'Place',
        name: 'Rio Negro, Amazonas, Brasil',
      },
    })} />
  </head>
  <body class="bg-background text-on-background antialiased min-h-screen flex flex-col">
    <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo</a>

    <header class="bg-surface-container-lowest border-b border-outline-variant/30 sticky top-0 z-40 backdrop-blur-sm">
      <div class="flex justify-between items-center px-6 h-16 w-full max-w-7xl mx-auto">
        <a href="/" class="font-display text-xl font-bold text-primary-container flex items-center gap-2 hover:opacity-80 transition-opacity">
          <img
            src="/images/brand/logo.jpg"
            alt="Logo Missão Amazônica"
            width={32}
            height={32}
            class="size-8 rounded-full object-cover bg-surface-container-lowest border border-outline-variant/30"
            loading="eager"
          />
          {SITE_NAME.replace(' – Sal da Terra', '')}
        </a>

        <nav class="hidden md:flex items-center gap-6 font-nav text-sm font-medium" aria-label="Navegação principal">
          <a
            href="/#missao"
            class:list={[
              'px-3 py-2 rounded-md transition-colors',
              activeNav === 'missao'
                ? 'text-primary-container border-b-2 border-primary-container pb-1'
                : 'text-on-surface-variant hover:text-primary-container hover:bg-surface-container-low',
            ]}
          >Missão</a>
          <a
            href="/doar"
            class:list={[
              'px-3 py-2 rounded-md transition-colors',
              activeNav === 'projetos'
                ? 'text-primary-container border-b-2 border-primary-container pb-1'
                : 'text-on-surface-variant hover:text-primary-container hover:bg-surface-container-low',
            ]}
          >Projetos</a>
          <a
            href="/prestacao-de-contas"
            class:list={[
              'px-3 py-2 rounded-md transition-colors',
              activeNav === 'transparencia'
                ? 'text-primary-container border-b-2 border-primary-container pb-1'
                : 'text-on-surface-variant hover:text-primary-container hover:bg-surface-container-low',
            ]}
          >Transparência</a>
          <a
            href="/#impacto"
            class:list={[
              'px-3 py-2 rounded-md transition-colors',
              activeNav === 'impacto'
                ? 'text-primary-container border-b-2 border-primary-container pb-1'
                : 'text-on-surface-variant hover:text-primary-container hover:bg-surface-container-low',
            ]}
          >Impacto</a>
        </nav>

        <div class="flex items-center gap-2">
          <a
            href="/doar"
            class="bg-primary-container text-on-primary px-4 py-2 rounded-lg type-label hover:opacity-90 transition-opacity shadow-cta inline-flex items-center gap-2"
          >
            <Icon name="hand_heart" size={16} />
            Contribuir
          </a>
          <ThemeToggle client:idle />
          <a
            href="/admin/login"
            aria-label="Área administrativa"
            class="text-on-surface-variant hover:bg-surface-container-low hover:text-primary-container p-2 rounded-full transition-colors hidden sm:inline-flex items-center justify-center"
          >
            <Icon name="account_circle" size={20} />
          </a>
        </div>
      </div>
      <button
        type="button"
        class="md:hidden absolute top-4 right-20 p-2 text-primary-container"
        aria-label="Abrir menu"
        data-mobile-menu-toggle
      >
        <Icon name="filter_list" size={20} />
      </button>
    </header>

    <main id="conteudo-principal" tabindex="-1" class="flex-grow">
      <slot />
    </main>

    <footer class="bg-surface-container-low border-t border-outline-variant/30 mt-auto">
      <div class="w-full max-w-7xl mx-auto px-6 lg:px-8 py-8 grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
        <div class="w-full">
          <div class="font-display text-base font-semibold text-on-surface mb-2 flex items-center gap-2">
            <img
              src="/images/brand/logo.jpg"
              alt=""
              aria-hidden="true"
              width={28}
              height={28}
              class="size-7 rounded-full object-cover bg-surface-container-lowest border border-outline-variant/30"
              loading="lazy"
            />
            {SITE_NAME}
          </div>
          <p class="font-nav text-xs text-on-surface-variant">
            Atuando no Rio Negro com transparência total.
          </p>
          <p class="font-nav text-xs text-on-surface-variant/70 mt-2">
            © {year} Missão Amazônica – Sal da Terra
          </p>
        </div>
        <nav aria-label="Plataforma" class="flex flex-col gap-2">
          <h3 class="type-label text-on-surface">Plataforma</h3>
          <a class="font-nav text-xs text-on-surface-variant hover:text-primary-container transition-colors" href="/prestacao-de-contas">Relatórios</a>
          <a class="font-nav text-xs text-on-surface-variant hover:text-primary-container transition-colors" href="/doar">Doar agora</a>
          <a class="font-nav text-xs text-on-surface-variant hover:text-primary-container transition-colors" href="/admin/login">Área administrativa</a>
        </nav>
        <div class="flex flex-col gap-2">
          <h3 class="type-label text-on-surface">Atuação</h3>
          <p class="font-nav text-xs text-on-surface-variant">Comunidades ribeirinhas do Rio Negro</p>
          <p class="font-nav text-xs text-on-surface-variant">Manaus / AM · Brasil</p>
          <p class="font-nav text-xs text-on-surface-variant">Expedição anual · Abril</p>
        </div>
      </div>
    </footer>

    <Toaster client:idle position="bottom-right" richColors closeButton />

    <SpeedInsights />
    <Analytics />

    {/* Reveal-on-scroll: add `is-visible` to `.reveal` elements once they intersect. */}
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach(function (el) { observer.observe(el); });
      })();
    </script>

    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </body>
</html>
