{
  "name": "missao-amazonica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de doações da Missão Amazônica – Sal da Terra",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "check": "astro check",
    "db:push": "supabase db push",
    "db:gen-types": "supabase gen types typescript --linked > src/lib/supabase/types.ts",
    "db:lint": "supabase db lint",
    "db:reset": "supabase db reset --linked",
    "setup:supabase": "bun run scripts/setup-supabase.ts",
    "setup:vercel": "bun run scripts/setup-vercel.ts",
    "deploy": "vercel deploy --prod"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/vercel": "^8.2.11",
    "@sentry/astro": "^8.55.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.105.1",
    "astro": "^5.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide": "^0.469.0",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.1",
    "ulid": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.19.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "supabase": "^2.96.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.18.0",
    "bun": ">=1.1.40"
  }
}
